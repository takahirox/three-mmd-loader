{
  "name": "three-mmd-loader",
  "version": "0.1.0",
  "description": "MMD loader, animation, physics, and export addons for Three.js",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./animation/CCDIKSolver.js": {
      "types": "./dist/animation/CCDIKSolver.d.ts",
      "import": "./dist/animation/CCDIKSolver.js",
      "default": "./dist/animation/CCDIKSolver.js"
    },
    "./animation/MMDAnimationHelper.js": {
      "types": "./dist/animation/MMDAnimationHelper.d.ts",
      "import": "./dist/animation/MMDAnimationHelper.js",
      "default": "./dist/animation/MMDAnimationHelper.js"
    },
    "./animation/MMDPhysics.js": {
      "types": "./dist/animation/MMDPhysics.d.ts",
      "import": "./dist/animation/MMDPhysics.js",
      "default": "./dist/animation/MMDPhysics.js"
    },
    "./exporters/MMDExporter.js": {
      "types": "./dist/exporters/MMDExporter.d.ts",
      "import": "./dist/exporters/MMDExporter.js",
      "default": "./dist/exporters/MMDExporter.js"
    },
    "./loaders/MMDLoader.js": {
      "types": "./dist/loaders/MMDLoader.d.ts",
      "import": "./dist/loaders/MMDLoader.js",
      "default": "./dist/loaders/MMDLoader.js"
    },
    "./materials/MMDToonMaterial.js": {
      "types": "./dist/materials/MMDToonMaterial.d.ts",
      "import": "./dist/materials/MMDToonMaterial.js",
      "default": "./dist/materials/MMDToonMaterial.js"
    },
    "./effects/MMDOutlineEffect.js": {
      "types": "./dist/effects/MMDOutlineEffect.d.ts",
      "import": "./dist/effects/MMDOutlineEffect.js",
      "default": "./dist/effects/MMDOutlineEffect.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/types.js",
    "dist/types.d.ts",
    "dist/ammo.js",
    "dist/ammo.d.ts",
    "dist/animation",
    "dist/exporters",
    "dist/loaders",
    "THIRD_PARTY_NOTICES.md",
    "dist/materials",
    "dist/effects",
    "dist/skinning"
  ],
  "scripts": {
    "build": "node --import tsx scripts/build-package.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json --noEmit && tsc -p tsconfig.tools.json && npm run check:typescript",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx --test tests/browser/*.test.ts",
    "dev": "node --import tsx scripts/serve-examples.ts",
    "examples:assets": "node --import tsx scripts/fetch-example-assets.ts",
    "build:examples": "npm run examples:assets && node --import tsx scripts/build-examples.ts",
    "setup:pages": "node --import tsx scripts/setup-pages.ts --configure",
    "test:examples": "node --import tsx --test tests/browser/examples.test.ts",
    "pretest:browser": "npm run build",
    "pretest:examples": "npm run build",
    "predev": "npm run build",
    "prebuild:examples": "npm run build",
    "pretypecheck": "npm run build",
    "check:typescript": "node --import tsx scripts/check-typescript.ts",
    "dev:sdef": "npm run build && node --import tsx scripts/serve-sdef.ts"
  },
  "peerDependencies": {
    "three": "~0.186.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/three": "0.186.0",
    "ammojs-typed": "1.1.0",
    "esbuild": "0.28.2",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takahirox/three-mmd-loader.git"
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "mmd-parser": "^1.1.3"
  }
}
