{
  "name": "three-mmd-loader",
  "version": "0.1.0",
  "description": "MMD loader, animation, physics, and export addons for Three.js",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./animation/CCDIKSolver.js": "./src/animation/CCDIKSolver.js",
    "./animation/MMDAnimationHelper.js": "./src/animation/MMDAnimationHelper.js",
    "./animation/MMDPhysics.js": "./src/animation/MMDPhysics.js",
    "./exporters/MMDExporter.js": "./src/exporters/MMDExporter.js",
    "./libs/mmdparser.module.js": "./src/libs/mmdparser.module.js",
    "./loaders/MMDLoader.js": "./src/loaders/MMDLoader.js",
    "./shaders/MMDToonShader.js": "./src/shaders/MMDToonShader.js"
  },
  "files": [
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser/*.test.js"
